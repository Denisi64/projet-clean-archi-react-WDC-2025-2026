{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "Node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@proj/domain": ["../../domain/src"],
      "@proj/domain/*": ["../../domain/src/*"],
      "@proj/application": ["../../application/src"],
      "@proj/application/*": ["../../application/src/*"]
    }
  },
  "references": [
    { "path": "../../domain" },
    { "path": "../../application" }
  ],
  "include": ["src"]
}
